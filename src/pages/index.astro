---
import '../styles/global.css';

const portfolio = [
  { name: 'Dream Dash', domain: 'dreamdash.org', text: 'The human command center for opportunity intelligence, capture, proposals, approvals, and delivery readiness.' },
  { name: 'Dream Track', domain: 'dreamtrack.org', text: 'Opportunity intelligence that turns fragmented market signals into qualified, actionable pursuits.' },
  { name: 'Dream Decks', domain: 'dreamdecks.org', text: 'A private external workspace connecting approved partners, buyers, sponsors, and delivery teams.' },
  { name: 'Dream Hive', domain: 'dreamhive.org', text: 'The secure service and operations plane behind the Dream portfolio.' },
];

const capabilities = [
  ['Discover', 'Find and understand consequential opportunities before the window closes.'],
  ['Decide', 'Bring evidence, risk, fit, and human judgment into a shared operating picture.'],
  ['Build', 'Coordinate people and intelligent systems around durable, reviewable workflows.'],
  ['Deliver', 'Carry context from pursuit through execution instead of losing it at handoff.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="United Dream Limited builds intelligent operating systems for ambitious organizations." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>United Dream Limited — Building what comes next</title>
  </head>
  <body>
    <header class="nav shell">
      <a class="brand" href="/" aria-label="United Dream Limited home"><span>UD</span> United Dream Limited</a>
      <nav aria-label="Primary navigation">
        <a href="#company">Company</a><a href="#portfolio">Portfolio</a><a href="#approach">Approach</a><a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <p class="eyebrow">Independent technology company · United States</p>
        <h1>Infrastructure for <em>ambition.</em></h1>
        <p class="lede">United Dream Limited builds and operates a portfolio of intelligent systems that help organizations discover opportunities, make better decisions, and turn complex work into durable outcomes.</p>
        <div class="actions"><a class="button" href="#portfolio">Explore the portfolio</a><a class="text-link" href="#company">About the company <span>↗</span></a></div>
        <div class="signal" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      </section>

      <section class="manifesto shell" id="company">
        <p class="section-label">01 / Company</p>
        <div><h2>We build the connective tissue between intent and execution.</h2><p>Important work rarely fails for lack of information. It fails when knowledge is fragmented, decisions are opaque, and momentum disappears between teams. We create systems that keep evidence, accountability, and action moving together.</p></div>
      </section>

      <section class="portfolio shell" id="portfolio">
        <div class="section-head"><p class="section-label">02 / Portfolio</p><h2>One company.<br/>A connected system.</h2></div>
        <div class="portfolio-grid">
          {portfolio.map((item, i) => <article><span class="number">0{i + 1}</span><h3>{item.name}</h3><p>{item.text}</p><a href={`https://${item.domain}`}>{item.domain} ↗</a></article>)}
        </div>
      </section>

      <section class="approach" id="approach">
        <div class="shell"><p class="section-label">03 / Operating approach</p><h2>From signal to outcome.</h2><div class="capability-grid">{capabilities.map(([title, text], i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div>
      </section>

      <section class="principles shell">
        <p class="section-label">04 / Principles</p>
        <div class="principle-list"><div><strong>Human authority</strong><p>Technology should sharpen judgment, preserve accountability, and make consequential decisions easier to inspect.</p></div><div><strong>Compounding systems</strong><p>Each project should leave the organization more capable than it found it—better evidence, stronger methods, reusable knowledge.</p></div><div><strong>Designed for reality</strong><p>We build for imperfect information, multiple stakeholders, regulated environments, and the operational work after launch.</p></div></div>
      </section>

      <section class="contact shell" id="contact"><p class="eyebrow">Work with United Dream Limited</p><h2>Let’s build what<br/>comes next.</h2><a class="button light" href="mailto:hello@dreamlimited.org">hello@dreamlimited.org</a></section>
    </main>

    <footer class="shell"><span>© {new Date().getFullYear()} United Dream Limited</span><span>dreamlimited.org</span></footer>
  </body>
</html>
